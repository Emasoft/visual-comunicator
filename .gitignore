.DS_Store

# Per agent rules: _dev folders for transient artifacts that must never be committed
/docs_dev/
/scripts_dev/
/samples_dev/
/examples_dev/
/tests_dev/
/downloads_dev/
/libs_dev/
/builds_dev/
/reports/
/reports_dev/

# Python bytecode caches
__pycache__/
*.pyc

# Janitor runtime state
/.janitor/

# Rechecker plugin runtime state
/.rechecker/

# Claude Code session artefacts (chat history, scheduled crons, lock files)
/.claude/

# tldr CLI runtime state + per-project ignore file
/.tldr/
/.tldrignore

# Vendored regex-vis build artefacts — node_modules is huge, dist is
# regenerable via `npm run build` in the vendor dir. Source lives under
# plugins/visual-explainer/vendor/regex-vis/src/ and IS committed.
plugins/visual-explainer/vendor/regex-vis/node_modules/
plugins/visual-explainer/vendor/regex-vis/dist/
